OPENAI_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
FMP_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PLUTUS_MAX_ARTICLES=10
# PLUTUS_ENV=dev|prod — prod: auto daily scan; dev: manual only (POST /api/v1/daily/trigger)
# PLUTUS_EXTRA_SYMBOLS={"oil":["BP","TTE"],"ai":["GOOGL"]}  # Add more symbols per topic (JSON)
# LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
# Polygon free tier: 5 req/min. Use fewer sectors (max_sectors=4) to avoid rate limits.
# PLUTUS_SITE_URL=https://yoursite.com  # For canonical URL, OG, sitemap
# PLUTUS_OG_IMAGE_URL=https://yoursite.com/og.png  # 1200x630 for social previews
# ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX  # From AdSense dashboard
# ADSENSE_BANNER_SLOT=1234567890  # Leaderboard ad unit (728x90)
# ADSENSE_SIDEBAR_SLOT=0987654321  # Rectangle ad unit (300x250)
